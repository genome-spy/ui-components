{
  "name": "@genome-spy/ui-components",
  "version": "1.3.0",
  "description": "Reusable GenomeSpy web components.",
  "license": "MIT",
  "type": "module",
  "customElements": "./dist/custom-elements.json",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.js"
    },
    "./contextMenu": {
      "types": "./dist/contextMenu.d.ts",
      "default": "./src/contextMenu.js"
    },
    "./contextMenu.css": {
      "types": "./src/stylesheet.d.ts",
      "default": "./src/contextMenu.css"
    },
    "./form.css": {
      "types": "./src/stylesheet.d.ts",
      "default": "./src/form.css"
    },
    "./custom-elements.json": "./dist/custom-elements.json",
    "./splitPanel": {
      "types": "./dist/splitPanel.d.ts",
      "default": "./src/splitPanel.js"
    },
    "./tabs": {
      "types": "./dist/tabs.d.ts",
      "default": "./src/tabs.js"
    },
    "./filePicker": {
      "types": "./dist/filePicker.d.ts",
      "default": "./src/filePicker.js"
    },
    "./dropZone": {
      "types": "./dist/dropZone.d.ts",
      "default": "./src/dropZone.js"
    },
    "./dialog": {
      "types": "./dist/dialog.d.ts",
      "default": "./src/dialog.js"
    },
    "./imageExportDialog": {
      "types": "./dist/imageExportDialog.d.ts",
      "default": "./src/imageExportDialog.js"
    },
    "./messageDialog": {
      "types": "./dist/messageDialog.d.ts",
      "default": "./src/messageDialog.js"
    },
    "./styles": {
      "types": "./dist/styles.d.ts",
      "default": "./src/styles.js"
    },
    "./customSelect": {
      "types": "./dist/customSelect.d.ts",
      "default": "./src/customSelect.js"
    },
    "./multiSelect": {
      "types": "./dist/multiSelect.d.ts",
      "default": "./src/multiSelect.js"
    },
    "./searchableCheckboxList": {
      "types": "./dist/searchableCheckboxList.d.ts",
      "default": "./src/searchableCheckboxList.js"
    },
    "./dataGrid": {
      "types": "./dist/dataGrid.d.ts",
      "default": "./src/dataGrid.js"
    },
    "./histogram": {
      "types": "./dist/histogram.d.ts",
      "default": "./src/histogram.js"
    },
    "./jobProgress": {
      "types": "./dist/jobProgress.d.ts",
      "default": "./src/jobProgress.js"
    },
    "./segmentedControl": {
      "types": "./dist/segmentedControl.d.ts",
      "default": "./src/segmentedControl.js"
    },
    "./thresholdComparisonInput": {
      "types": "./dist/thresholdComparisonInput.d.ts",
      "default": "./src/thresholdComparisonInput.js"
    },
    "./formController": {
      "types": "./dist/formController.d.ts",
      "default": "./src/formController.js"
    },
    "./formField": {
      "types": "./dist/formField.d.ts",
      "default": "./src/formField.js"
    },
    "./dialogWizardController": {
      "types": "./dist/dialogWizardController.d.ts",
      "default": "./src/dialogWizardController.js"
    },
    "./define/*": {
      "types": "./dist/define/*.d.ts",
      "default": "./src/define/*.js"
    }
  },
  "sideEffects": [
    "./src/define/*.js",
    "./src/contextMenu.css",
    "./src/form.css"
  ],
  "files": [
    "src/*.js",
    "src/contextMenu.css",
    "src/form.css",
    "src/stylesheet.d.ts",
    "src/define/",
    "!src/*.test.js",
    "dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --declaration --emitDeclarationOnly && npm run build:manifest",
    "build:manifest": "cem analyze --quiet",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:packed-consumer": "node scripts/testPackedConsumer.mjs",
    "test:tsc": "tsc -p tsconfig.json --noEmit",
    "storybook": "npm run build:manifest && storybook dev -p 6010",
    "build-storybook": "npm run build:manifest && storybook build -o build/storybook"
  },
  "peerDependencies": {
    "lit": "^3.3.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.6.1",
    "@fortawesome/free-solid-svg-icons": "^6.4.2",
    "d3-array": "^3.2.4"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/web-components-vite": "10.6.3",
    "@types/d3-array": "3.2.2",
    "jsdom": "24.1.3",
    "lit": "3.3.3",
    "playwright": "1.64.1",
    "storybook": "10.6.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
