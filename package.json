{
  "name": "@genome-spy/ui-components",
  "version": "0.2.0",
  "description": "Reusable GenomeSpy web components.",
  "license": "MIT",
  "type": "module",
  "customElements": "./dist/custom-elements.json",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.js"
    },
    "./custom-elements.json": "./dist/custom-elements.json",
    "./*.css": {
      "types": "./src/internal/stylesheet.d.ts",
      "default": "./src/*.css"
    },
    "./index": null,
    "./internal/*": null,
    "./*.test": null,
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.js"
    }
  },
  "sideEffects": [
    "./src/define/*.js",
    "./src/*.css"
  ],
  "files": [
    "CHANGELOG.md",
    "src/*.js",
    "src/*.css",
    "src/define/",
    "src/internal/",
    "!src/**/*.test.js",
    "dist/",
    "src/assets/",
    "licenses/",
    "SOURCES.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genome-spy/ui-components.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json --declaration --emitDeclarationOnly && npm run build:manifest",
    "build:manifest": "cem analyze --quiet",
    "prepack": "npm run build",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --ignore-path .gitignore --check .",
    "check": "npm run lint && npm run format:check && npm run test:tsc && npm test",
    "changeset": "changeset",
    "release:status": "changeset status",
    "release:version": "changeset version && npm install --package-lock-only --ignore-scripts --no-audit --no-fund",
    "test": "vitest run",
    "test:packed-consumer": "node scripts/testPackedConsumer.mjs",
    "test:tsc": "tsc -p tsconfig.json --noEmit",
    "storybook": "npm run build:manifest && storybook dev -p 6010",
    "build-storybook": "npm run build:manifest && storybook build -o build/storybook"
  },
  "peerDependencies": {
    "lit": "^3.3.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.6.1",
    "@fortawesome/free-solid-svg-icons": "^6.4.2",
    "d3-array": "^3.2.4"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/js": "10.0.1",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/web-components-vite": "10.6.3",
    "@types/d3-array": "3.2.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "24.1.3",
    "lit": "3.3.3",
    "pkg-pr-new": "0.0.93",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "storybook": "10.6.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
